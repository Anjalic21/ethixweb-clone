# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings > API

# URL is safe to expose publicly (used by both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — safe for browser use
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by API routes.
SUPABASE_SECRET_KEY=your-secret-key-here

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# next-auth v5 reads AUTH_SECRET (not NEXTAUTH_SECRET).
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# ── Admin credentials ─────────────────────────────────────────────────────────
# Email address for the single admin account
ADMIN_EMAIL=admin@yourdomain.com

# bcrypt hash of the admin password (cost factor 12 recommended).
# Generate with Node.js:
#   node -e "const b=require('bcryptjs'); b.hash('your-password',12).then(console.log)"
# Or with the bcrypt CLI if installed.
# Never store the plain-text password here or anywhere in the codebase.
ADMIN_PASSWORD_HASH=$2b$12$replace-this-with-a-real-bcrypt-hash

# ── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Required in production. The enquiry API blocks all submissions if these are
# absent when NODE_ENV=production.
# Create a free Redis database at https://console.upstash.com/
# Then copy the REST URL and token from the database details page.
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here
